# Admin-only configuration, independent of the root Expo environment.
# Use an existing staging account. T05/T08 migrations must be applied to that project.
ADMIN_ORIGIN=http://localhost:3000
ADMIN_SUPABASE_URL=https://REPLACE_WITH_STAGING_PROJECT.supabase.co
ADMIN_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# T11 directory commands require this server-only key from the SAME project.
# Never use NEXT_PUBLIC_ or copy this value into Expo configuration.
ADMIN_SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SECRET_KEY
