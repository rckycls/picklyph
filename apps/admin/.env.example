# Admin-only configuration, independent of the root Expo environment.
# Use an existing staging account. T05/T08 migrations must be applied to that project.
ADMIN_ORIGIN=http://localhost:3000
ADMIN_SUPABASE_URL=https://REPLACE_WITH_STAGING_PROJECT.supabase.co
ADMIN_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# T11 directory commands require this server-only key from the SAME project.
# Never use NEXT_PUBLIC_ or copy this value into Expo configuration.
ADMIN_SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SECRET_KEY
# T54b: sending new pre-launch claim codes from Pre-launch (admins only). Without these the list and Erase still
# work, and Send new code answers "not set up". All server-only; never NEXT_PUBLIC_.
# PRELAUNCH_CODE_SECRET must equal the registration page's and the project's owner-submissions function secret.
PRELAUNCH_CODE_SECRET=REPLACE_WITH_SAME_SECRET_AS_THE_REGISTRATION_PAGE
PRELAUNCH_ORIGIN=https://REPLACE_WITH_REGISTRATION_PAGE_DOMAIN
PRELAUNCH_CONTACT_EMAIL=REPLACE_WITH_CONTACT_ADDRESS
EMAIL_API_KEY=REPLACE_WITH_EMAIL_PROVIDER_KEY
EMAIL_FROM=pickly <REPLACE_WITH_SENDER@your-domain>
# Optional: EMAIL_API_URL (defaults to Resend), PRELAUNCH_APP_URL (the App Store link, once the app is out).
