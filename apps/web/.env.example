# Pre-launch registration page (T53), independent of the root Expo and apps/admin environments.
# Copy to apps/web/.env.local for local runs; hosted values live in the apps/web Vercel project (H13).
# Every value is read on the server per request. The page receives only TURNSTILE_SITE_KEY,
# GOOGLE_MAPS_BROWSER_API_KEY and PRELAUNCH_CONTACT_EMAIL. Never use NEXT_PUBLIC_ names here.
# See docs/prelaunch-registration.md.

# local | staging | production. Production refuses http origins, loopback stand-ins and Turnstile test keys.
PICKLY_ENV=local
# This page's own origin (no path). Every POST must come from it.
PRELAUNCH_ORIGIN=http://localhost:3200
PRELAUNCH_CONTACT_EMAIL=REPLACE_WITH_PRIVACY_CONTACT_ADDRESS

# Live registrations go to the PRODUCTION project only (T50); staging is for trials. Server-only secret key.
PRELAUNCH_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PRELAUNCH_SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SECRET_KEY

# Keyed hash of claim codes (32+ random characters). T54 redemption needs the same value; never rotate it
# while unclaimed codes are outstanding.
PRELAUNCH_CODE_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# Upstash Redis REST (the same database and salt rules as the Edge functions of that environment).
UPSTASH_REDIS_REST_URL=https://REPLACE_WITH_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_TOKEN
RATE_LIMIT_KEY_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# Cloudflare Turnstile. For local runs Cloudflare's test keys work: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA (never accepted when PICKLY_ENV=production).
TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# Google: a browser key restricted to this domain's referrers and the Maps JavaScript API only, and the
# server Geocoding key (the same restricted key the owner-submissions function uses).
GOOGLE_MAPS_BROWSER_API_KEY=REPLACE_WITH_BROWSER_MAPS_KEY
GOOGLE_MAPS_SERVER_API_KEY=REPLACE_WITH_SERVER_GEOCODING_KEY

# Email provider HTTP API (Resend by default). EMAIL_FROM must use the verified sending domain.
EMAIL_API_KEY=REPLACE_WITH_EMAIL_PROVIDER_KEY
EMAIL_FROM=pickly <REPLACE_WITH_SENDER_ADDRESS>
# EMAIL_API_URL=https://api.resend.com/emails
