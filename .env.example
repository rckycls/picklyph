# PicklyPH configuration reference. All values below are placeholders.
# Copy to the root .env or .env.local for MOBILE development only.
# Maps build configuration and the lazy public Supabase client read their values.

# MOBILE PUBLIC: included in the JavaScript bundle when referenced by Expo.
# Use the same STAGING Supabase project for both values. Never use a secret or
# legacy service_role key here. Data access still requires grants and RLS.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY

# NATIVE iOS BUILD CONFIG: read by the react-native-maps config plugin.
# This key ships in the binary; restrict it to the chosen iOS bundle identifier
# and Maps SDK for iOS. Keep it separate from the server geocoding key.
GOOGLE_MAPS_IOS_API_KEY=REPLACE_WITH_IOS_RESTRICTED_MAPS_KEY

# Optional build metadata. Leave commented to use com.rckycls.picklyph.
# IOS_BUNDLE_IDENTIFIER=REPLACE_WITH_MATCHING_IOS_BUNDLE_IDENTIFIER
# EAS_PROJECT_ID=REPLACE_WITH_EAS_PROJECT_UUID

# SERVER ONLY: reference names, intentionally commented out. Do not put real
# server credentials in the mobile root .env or Expo/EAS app configuration.
# Configure them in the backend hosting secret store (or a separate ignored
# backend env file when that workspace exists). Never prefix with EXPO_PUBLIC_.
# Supabase-hosted functions inject SUPABASE_URL and SUPABASE_SECRET_KEYS; do not
# override them. SUPABASE_ is reserved for platform variables. For another
# server host, these optional project names avoid that reserved prefix:
# PICKLYPH_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# PICKLYPH_SUPABASE_SECRET_KEY=REPLACE_WITH_SUPABASE_SERVER_SECRET_KEY
# The server URL/key must belong to the same project and deployment environment.
# UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_SERVER_REST_TOKEN
# Edge function secret: Geocoding API only, quota-capped; never the iOS key.
# GOOGLE_MAPS_SERVER_API_KEY=REPLACE_WITH_SERVER_GEOCODING_ONLY_KEY

# Payment reference only; see docs/payment-integration.md and H03 activation gates.
# Separate backend deployments use test/live credentials and endpoint secrets.
# PAYMONGO_MODE=test
# PAYMONGO_SECRET_KEY=REPLACE_WITH_PAYMONGO_SERVER_SECRET_KEY
# PAYMONGO_WEBHOOK_SECRET=REPLACE_WITH_PAYMONGO_ENDPOINT_SIGNING_SECRET
