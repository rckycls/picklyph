{
  "name": "picklyph",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.3.0",
    "npm": ">=11"
  },
  "scripts": {
    "start": "expo start",
    "start:ios": "expo start --ios",
    "start:dev-client": "expo start --dev-client",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @picklyph/domain",
    "lint": "eslint . --max-warnings 0",
    "test:discovery": "node --test src/features/discovery/__tests__/*.test.cjs",
    "test:directory": "node --test --test-concurrency=6 supabase/tests/*.test.cjs",
    "test:search": "node --test supabase/tests/search.test.cjs",
    "test:search:local": "node supabase/tests/search-local.cjs",
    "test:owner": "node --test src/features/owner/__tests__/*.test.cjs",
    "test:owner:local": "node supabase/tests/owner-local.cjs",
    "test:venues:local": "node supabase/tests/owner-venues-local.cjs",
    "test:schedules:local": "node supabase/tests/schedules-local.cjs",
    "test:policies:local": "node supabase/tests/policies-local.cjs",
    "test:allocations:local": "node supabase/tests/allocations-local.cjs",
    "test:calendar:local": "node supabase/tests/calendar-local.cjs",
    "test:rentals": "node --test supabase/tests/rentals.test.cjs",
    "test:rentals:local": "node supabase/tests/rentals-local.cjs",
    "functions:check": "npm exec --yes --package=deno@2.9.6 -- deno check --config supabase/functions/deno.json supabase/functions/venue-search/index.ts supabase/functions/owner-submissions/index.ts supabase/functions/owner-venues/index.ts supabase/functions/owner-schedules/index.ts supabase/functions/_shared/allocations.ts supabase/functions/rental-bookings/index.ts supabase/functions/owner-sessions/index.ts supabase/functions/session-bookings/index.ts supabase/functions/venue-reports/index.ts supabase/functions/account-deletion/index.ts",
    "functions:lint": "npm exec --yes --package=deno@2.9.6 -- deno lint --config supabase/functions/deno.json supabase/functions",
    "test:functions": "npm exec --yes --package=deno@2.9.6 -- deno test --allow-env --config supabase/functions/deno.json supabase/functions/tests",
    "test:directory:local": "docker exec -i supabase_db_picklyph psql -U postgres -d postgres -v ON_ERROR_STOP=1 -X -q < supabase/tests/directory.sql",
    "check:dependencies": "expo install --check",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios",
    "test:auth": "node --test src/features/auth/__tests__/*.test.cjs",
    "test:rental:mobile": "node --test src/features/rental/__tests__/*.test.cjs",
    "test:open-play": "node --test src/features/openPlay/__tests__/*.test.cjs",
    "test:account": "node --test src/features/account/__tests__/*.test.cjs",
    "test:calendar": "node --test src/components/calendar/__tests__/*.test.cjs src/features/bookings/__tests__/*.test.cjs",
    "test:mascot": "node --test src/components/mascot/__tests__/*.test.cjs src/features/welcome/__tests__/*.test.cjs src/features/rental/__tests__/celebration.test.cjs src/features/rental/__tests__/bookingMascot.test.cjs",
    "test:auth:local": "node supabase/tests/auth-local.cjs",
    "test:authorization:local": "node supabase/tests/authorization-local.cjs",
    "test:profile:local": "node supabase/tests/profile-local.cjs",
    "test:domain": "npm test --workspace @picklyph/domain",
    "admin:dev": "npm run dev --workspace @picklyph/admin",
    "admin:build": "npm run build --workspace @picklyph/admin",
    "admin:typecheck": "npm run typecheck --workspace @picklyph/admin",
    "admin:lint": "npm run lint --workspace @picklyph/admin",
    "test:admin": "npm test --workspace @picklyph/admin",
    "test:admin:local": "node apps/admin/tests/local.cjs",
    "test:review:local": "node apps/admin/tests/review-local.cjs",
    "test:bookings": "node --test supabase/tests/rental-bookings.test.cjs supabase/tests/rental-handler.test.cjs",
    "test:bookings:local": "node supabase/tests/rental-bookings-local.cjs",
    "test:sessions": "node --test supabase/tests/sessions.test.cjs supabase/tests/session-handler.test.cjs",
    "test:sessions:local": "node supabase/tests/sessions-local.cjs",
    "test:session-bookings": "node --test supabase/tests/session-bookings.test.cjs supabase/tests/session-booking-handler.test.cjs",
    "test:session-bookings:local": "node supabase/tests/session-bookings-local.cjs",
    "test:operations": "node --test supabase/tests/booking-operations.test.cjs",
    "test:operations:local": "node supabase/tests/booking-operations-local.cjs",
    "test:expiry": "node --test supabase/tests/hold-expiry.test.cjs",
    "test:expiry:local": "node supabase/tests/hold-expiry-local.cjs",
    "test:boundaries": "node --test supabase/tests/booking-boundaries.test.cjs",
    "test:boundaries:local": "node supabase/tests/booking-boundaries-local.cjs",
    "test:moderation": "node --test supabase/tests/moderation.test.cjs supabase/tests/report-handler.test.cjs",
    "test:moderation:local": "node supabase/tests/moderation-local.cjs",
    "test:privacy": "node --test supabase/tests/account-deletion.test.cjs supabase/tests/account-deletion-handler.test.cjs",
    "test:privacy:local": "node supabase/tests/account-deletion-local.cjs",
    "test:acceptance:local": "node supabase/tests/acceptance-local.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@expo/log-box": "57.0.4",
    "@expo/metro-runtime": "57.0.16",
    "@picklyph/domain": "0.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.2",
    "expo": "57.0.26",
    "expo-apple-authentication": "57.0.2",
    "expo-constants": "57.0.20",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-image-picker": "57.0.20",
    "expo-linking": "57.0.11",
    "expo-location": "57.0.20",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-postgis": "0.2.8",
    "@types/react": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "supabase": "2.119.0",
    "typescript": "6.0.3"
  }
}
