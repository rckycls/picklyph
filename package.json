{
  "name": "picklyph",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.3.0",
    "npm": ">=11"
  },
  "scripts": {
    "start": "expo start",
    "start:ios": "expo start --ios",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @picklyph/domain",
    "lint": "eslint . --max-warnings 0",
    "test:discovery": "node --test src/features/discovery/__tests__/*.test.cjs",
    "test:directory": "node --test supabase/tests/*.test.cjs",
    "test:directory:local": "docker exec -i supabase_db_picklyph psql -U postgres -d postgres -v ON_ERROR_STOP=1 -X -q < supabase/tests/directory.sql",
    "check:dependencies": "expo install --check",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios",
    "test:auth": "node --test src/features/auth/__tests__/*.test.cjs",
    "test:auth:local": "node supabase/tests/auth-local.cjs",
    "test:authorization:local": "node supabase/tests/authorization-local.cjs",
    "test:domain": "npm test --workspace @picklyph/domain"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@expo/log-box": "57.0.4",
    "@expo/metro-runtime": "57.0.16",
    "@picklyph/domain": "0.1.0",
    "@supabase/supabase-js": "2.117.2",
    "expo": "57.0.26",
    "expo-apple-authentication": "57.0.2",
    "expo-constants": "57.0.20",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.11",
    "expo-location": "57.0.20",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-postgis": "0.2.8",
    "@types/react": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "supabase": "2.119.0",
    "typescript": "6.0.3"
  }
}
